<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{10} %msg%n</pattern>
    </encoder>
  </appender>

  <!-- log levels -->
  <logger name="com.datastax.driver.core" level="ERROR"/>
  <logger name="com.evolutiongaming.pillar" level="INFO"/>

  <!--
  Recommended logback config for testcontainers:
  https://java.testcontainers.org/supported_docker_environment/logging_config/ -->
  <logger name="org.testcontainers" level="INFO"/>
  <!-- The following logger can be used for containers logs since 1.18.0 -->
  <logger name="tc" level="INFO"/>
  <logger name="com.github.dockerjava" level="WARN"/>
  <logger name="com.github.dockerjava.zerodep.shaded.org.apache.hc.client5.http.wire" level="OFF"/>
  <!-- -->

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
